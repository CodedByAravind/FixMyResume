# Database configuration
# For SQLite (default for local development):
DATABASE_URL=sqlite:///./fixmyresume.db

# For PostgreSQL (when ready to switch):
# DATABASE_URL=postgresql://user:password@localhost:5432/fixmyresume

# Application
# APP_NAME=FixMyResume
# APP_VERSION=0.1.0
# DEBUG=false

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security / JWT
# Use a long random string in production (never commit real secret)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
